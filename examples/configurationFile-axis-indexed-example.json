{
  "versions": {
    "essentials": {
      "version": "3.0.0-rc.17",
      "repoUrl": "https://github.com/PepperDash/Essentials",
      "packageId": "PepperDashEssentials"
    },
    "packages": [
      {
        "packageId": "epi-axis-camera",
        "version": "REPLACE-WITH-RELEASE-VERSION",
        "repoUrl": "https://github.com/PepperDash/epi-axis-camera"
      }
    ],
    "userInterfaces": []
  },
  "system": {},
  "system_url": "",
  "template": {
    "info": {
      "comment": "Example: many cameras on one EISC, laid out by camera number (joinLayout indexed, joinStart 1 for every camera). The cameras are configured here, once: address, login and name. SIMPL is sent only what it needs: the camera name (serial join n) and a preview URL for the touch panels (serial join 50 + n). The decoder streams are the cameras (cameraKey), at their own resolution. The decoders use the indexed layout too (decoderIndex, up to 8 on one small EISC).",
      "systemType": "huddle",
      "processorType": "cp4n",
      "lastUid": 7
    },
    "devices": [
      {
        "key": "processor",
        "uid": 1,
        "name": "CP4N",
        "type": "cp4n",
        "group": "processor",
        "properties": {}
      },
      {
        "key": "cam-01",
        "uid": 2,
        "name": "Left PTZ",
        "type": "axisCamera",
        "group": "camera",
        "properties": {
          "host": "192.168.10.241",
          "username": "admin",
          "password": "REPLACE",
          "joinLayout": "indexed",
          "cameraIndex": 1,
          "presetMode": "server",
          "presetCount": 8,
          "previewResolution": "800x450"
        }
      },
      {
        "key": "cam-02",
        "uid": 3,
        "name": "Right PTZ",
        "type": "axisCamera",
        "group": "camera",
        "properties": {
          "host": "192.168.10.242",
          "username": "admin",
          "password": "REPLACE",
          "joinLayout": "indexed",
          "cameraIndex": 2,
          "presetMode": "server",
          "presetCount": 8,
          "previewResolution": "800x450"
        }
      },
      {
        "key": "cam-03",
        "uid": 4,
        "name": "Shared Monopod",
        "type": "axisCamera",
        "group": "camera",
        "properties": {
          "host": "192.168.10.240",
          "username": "admin",
          "password": "REPLACE",
          "joinLayout": "indexed",
          "cameraIndex": 3,
          "presetMode": "server",
          "presetCount": 8,
          "previewResolution": "800x450"
        }
      },
      {
        "key": "d1110-1",
        "uid": 5,
        "name": "D1110 #1",
        "type": "axisD1110",
        "group": "decoder",
        "properties": {
          "host": "192.168.10.60",
          "username": "root",
          "password": "REPLACE",
          "resolution": "1920x1080",
          "streams": {
            "1": {
              "cameraKey": "cam-01"
            },
            "2": {
              "cameraKey": "cam-02"
            },
            "3": {
              "cameraKey": "cam-03"
            }
          },
          "joinLayout": "indexed",
          "decoderIndex": 1
        }
      },
      {
        "key": "eisc-cameras",
        "uid": 6,
        "name": "Axis Cameras EISC",
        "type": "eiscApiAdvanced",
        "group": "api",
        "properties": {
          "control": {
            "tcpSshProperties": {
              "address": "127.0.0.2",
              "port": 0
            },
            "ipid": "F2"
          },
          "devices": [
            {
              "deviceKey": "cam-01",
              "joinStart": 1
            },
            {
              "deviceKey": "cam-02",
              "joinStart": 1
            },
            {
              "deviceKey": "cam-03",
              "joinStart": 1
            }
          ]
        }
      },
      {
        "key": "eisc-decoders",
        "uid": 7,
        "name": "Axis Decoders EISC",
        "type": "eiscApiAdvanced",
        "group": "api",
        "properties": {
          "control": {
            "tcpSshProperties": {
              "address": "127.0.0.2",
              "port": 0
            },
            "ipid": "F3"
          },
          "devices": [
            {
              "deviceKey": "d1110-1",
              "joinStart": 1
            }
          ]
        }
      }
    ],
    "rooms": [],
    "sourceLists": {},
    "tieLines": []
  }
}
